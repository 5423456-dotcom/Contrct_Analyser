# GitHub Linguist Language Configuration
# Ensures correct language statistics graph on GitHub

*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
*.py linguist-language=Python
*.css linguist-language=CSS
*.html linguist-language=HTML

# Exclude batch launcher scripts from dominating the language graph
*.bat linguist-detectable=false

# Mark generated files and binaries
package-lock.json linguist-generated=true
*.pdf linguist-generated=true
